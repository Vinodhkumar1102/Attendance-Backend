{
  "info": {
    "name": "Attendance Admin API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://attendance-backend-11.onrender.com"
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"datavibes80@gmail.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body.token) {",
              "  pm.collectionVariables.set('adminToken', body.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api",
          "host": ["{{baseUrl}}"],
          "path": ["api"]
        }
      }
    },
    {
      "name": "Admin Forgot Password - Send OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"datavibes80@gmail.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/forgot-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "forgot-password"]
        }
      }
    },
    {
      "name": "Admin Forgot Password - Verify OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"datavibes80@gmail.com\",\n  \"resetCode\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/verify-reset-code",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "verify-reset-code"]
        }
      }
    },
    {
      "name": "Admin Forgot Password - Reset Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"datavibes80@gmail.com\",\n  \"resetCode\": \"123456\",\n  \"newPassword\": \"654321\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "reset-password"]
        }
      }
    }
  ]
}
